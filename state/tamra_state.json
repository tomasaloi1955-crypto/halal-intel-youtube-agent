    "texts": {
      "hook": "Создаём онлайн‑школу для детей",
      "title": "Как я строю онлайн‑школу для мусульманских детей с ИИ",
      "caption": "Вы хотите, чтобы ваш ребёнок учился с ИИ?\nTamra School – 2 часа в день, свободный остаток для Корана и семьи.\nБесплатный тест уровня уже в профиле. Попробуйте!",
      "hashtags": [
        "#ислам",
        "#образование",
        "#онлайншкола",
        "#мусульманскиедети",
        "#исламскоедвижение",
        "#tamraschool",
        "#исламскаяшкола",
        "#семейноеобучение",
        "#мусульманскаясемья",
        "#воспитаниедетей"
      ],
      "subtitles": [
        {
          "text": "Я не программист,",
          "start": 0.52,
          "end": 1.52
        },
        {
          "text": "но я строю целую",
          "start": 1.52,
          "end": 2.46
        },
        {
          "text": "онлайн школу для",
          "start": 2.46,
          "end": 3.32
        },
        {
          "text": "мусульманских детей.",
          "start": 3.32,
          "end": 4.5
        },
        {
          "text": "И пишу я не",
          "start": 4.6,
          "end": 5.38
        },
        {
          "text": "я,",
          "start": 5.38,
          "end": 5.68
        },
        {
          "text": "а пишет АИ.",
          "start": 5.68,
          "end": 6.58
        },
        {
          "text": "И это называется",
          "start": 6.94,
          "end": 7.56
        },
        {
          "text": "вайп-кодингом.",
          "start": 7.56,
          "end": 8.4
        },
        {
          "text": "Сейчас объясню задачу.",
          "start": 8.9,
          "end": 10.12
        },
        {
          "text": "Открываем Клод Код,",
          "start": 10.12,
          "end": 11.56
        },
        {
          "text": "пишем ему задачу своими",
          "start": 11.56,
          "end": 12.96
        },
        {
          "text": "словами.",
          "start": 12.96,
          "end": 13.9
        },
        {
          "text": "Построим мне онлайн",
          "start": 13.46,
          "end": 14.42
        },
        {
          "text": "школу для мусульманских",
          "start": 14.42,
          "end": 15.92
        },
        {
          "text": "детей.",
          "start": 15.92,
          "end": 16.46
        },
        {
          "text": "Это будет не обычная",
          "start": 16.7,
          "end": 17.58
        },
        {
          "text": "школа,",
          "start": 17.58,
          "end": 18.04
        },
        {
          "text": "потому что обычная школа",
          "start": 18.04,
          "end": 19.54
        },
        {
          "text": "мне не подходила.",
          "start": 19.54,
          "end": 20.66
        },
        {
          "text": "И у меня здесь",
          "start": 21.06,
          "end": 21.72
        },
        {
          "text": "будет несколько",
          "start": 21.72,
          "end": 22.36
        },
        {
          "text": "проверяльщиков,",
          "start": 22.36,
          "end": 23.26
        },
        {
          "text": "которые будут проверять",
          "start": 23.26,
          "end": 23.98
        },
        {
          "text": "достоверность",
          "start": 23.98,
          "end": 24.52
        },
        {
          "text": "информации.",
          "start": 24.52,
          "end": 25.6
        },
        {
          "text": "Еще один помощник,",
          "start": 25.64,
          "end": 26.52
        },
        {
          "text": "он будет охранять данные",
          "start": 26.52,
          "end": 27.6
        },
        {
          "text": "детей.",
          "start": 27.6,
          "end": 28.08
        },
        {
          "text": "Сейчас я готовлю запуск",
          "start": 28.46,
          "end": 29.48
        },
        {
          "text": "с первыми 10 детьми.",
          "start": 29.48,
          "end": 30.8
        },
        {
          "text": "Арабский переделал на",
          "start": 31.16,
          "end": 32.22
        },
        {
          "text": "Моалим Сани и записываю",
          "start": 32.22,
          "end": 33.52
        },
        {
          "text": "свой голос.",
          "start": 33.52,
          "end": 34.32
        },
        {
          "text": "А если ты хочешь",
          "start": 34.52,
          "end": 35.2
        },
        {
          "text": "видеть,",
          "start": 35.2,
          "end": 35.58
        },
        {
          "text": "как школа растет с",
          "start": 35.58,
          "end": 36.4
        },
        {
          "text": "нуля,",
          "start": 36.4,
          "end": 36.66
        },
        {
          "text": "подписывайся.",
          "start": 36.66,
          "end": 37.38
        },
        {
          "text": "Если тоже хочешь что-то",
          "start": 37.88,
          "end": 38.9
        },
        {
          "text": "автоматизировать,",
          "start": 38.9,
          "end": 39.62
        },
        {
          "text": "пиши в телеграм,",
          "start": 39.62,
          "end": 40.36
        },
        {
          "text": "ссылка в профиле.",
          "start": 40.36,
          "end": 41.2
        }
      ]
    },
