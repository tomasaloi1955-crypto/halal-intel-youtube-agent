      "texts": {
        "hook": "Только 2 часа учёбы в день",
        "title": "Тамра Скул: 2 часа с ИИ, всё для Корана и семьи",
        "caption": "Учится ли ваш ребёнок только 2 часа в день?\nС ИИ в Тамра Скул он успевает математику, русский и английский.\nОставшееся время — Коран, арабский, спорт и семья.\nКакой баланс вам нужен?\nБесплатный тест уровня — ссылка в профиле.",
        "hashtags": [
          "#образование",
          "#семья",
          "#мамавдом",
          "#исламскоепросвещение",
          "#онлайншкола",
          "#tamraschool",
          "#исламскаяшкола",
          "#семейноеобучение",
          "#мусульманскаясемья",
          "#воспитаниедетей"
        ],
        "subtitles": [
          {
            "text": "Ну что ж,",
            "start": 1.48,
            "end": 1.94
          },
          {
            "text": "сегодня второй день,",
            "start": 1.94,
            "end": 3.14
          },
          {
            "text": "и давайте подумаем.",
            "start": 3.14,
            "end": 4.5
          },
          {
            "text": "Смотрите,",
            "start": 4.44,
            "end": 5.22
          },
          {
            "text": "ребенок сидит в школе",
            "start": 5.22,
            "end": 6.3
          },
          {
            "text": "6 часов,",
            "start": 6.3,
            "end": 6.94
          },
          {
            "text": "потом еще 2 часа",
            "start": 6.94,
            "end": 8.4
          },
          {
            "text": "у него домашка,",
            "start": 8.4,
            "end": 9.34
          },
          {
            "text": "а когда же ему",
            "start": 9.34,
            "end": 10.0
          },
          {
            "text": "учить Коран?",
            "start": 10.0,
            "end": 10.68
          },
          {
            "text": "В Тамра Скул учеба",
            "start": 11.26,
            "end": 12.4
          },
          {
            "text": "занимает 2 часа в",
            "start": 12.4,
            "end": 13.4
          },
          {
            "text": "день.",
            "start": 13.4,
            "end": 13.66
          },
          {
            "text": "Ребенок занимается с",
            "start": 14.24,
            "end": 15.36
          },
          {
            "text": "искусственным",
            "start": 15.36,
            "end": 15.8
          },
          {
            "text": "интеллектом в своем",
            "start": 15.8,
            "end": 16.8
          },
          {
            "text": "темпе и не идет",
            "start": 16.8,
            "end": 18.24
          },
          {
            "text": "дальше,",
            "start": 18.24,
            "end": 18.74
          },
          {
            "text": "пока не понял тему.",
            "start": 18.74,
            "end": 19.74
          },
          {
            "text": "Освободившееся время",
            "start": 20.42,
            "end": 21.6
          },
          {
            "text": "остается на Коран и",
            "start": 21.6,
            "end": 22.8
          },
          {
            "text": "кружки,",
            "start": 22.8,
            "end": 23.7
          },
          {
            "text": "на арабский и семью.",
            "start": 23.7,
            "end": 25.04
          },
          {
            "text": "Так учатся дети в",
            "start": 25.72,
            "end": 26.68
          },
          {
            "text": "американская Альфа Скул.",
            "start": 26.68,
            "end": 28.1
          },
          {
            "text": "Я делаю такую же",
            "start": 28.7,
            "end": 29.6
          },
          {
            "text": "школу,",
            "start": 29.6,
            "end": 30.04
          },
          {
            "text": "только исламскую.",
            "start": 30.04,
            "end": 31.06
          },
          {
            "text": "Это день второй.",
            "start": 31.24,
            "end": 32.04
          },
          {
            "text": "Подписывайся,",
            "start": 32.04,
            "end": 33.08
          },
          {
            "text": "чтобы увидеть,",
            "start": 33.08,
            "end": 33.9
          },
          {
            "text": "как она растет.",
            "start": 33.9,
            "end": 34.62
          }
        ],
