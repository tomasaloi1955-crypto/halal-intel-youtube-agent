          {
            "text": "искусственным",
            "start": 15.36,
            "end": 15.8
          },
          {
            "text": "интеллектом в своем",
            "start": 15.8,
            "end": 16.8
          },
          {
            "text": "темпе и не идет",
            "start": 16.8,
            "end": 18.24
