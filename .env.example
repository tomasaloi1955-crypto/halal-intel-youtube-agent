# ElevenLabs (Shorts озвучка, ~$11/мес: elevenlabs.io)
ELEVENLABS_API_KEY=sk_...твой_ключ
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pexels резерв (бесплатно: pexels.com/api)
PEXELS_API_KEY=...твой_ключ

# Pixabay резерв (бесплатно: pixabay.com/api/docs)
PIXABAY_API_KEY=...твой_ключ

# Telegram-алерты автопилота (опционально). Бот шлёт тебе "СБОЙ"/"опубликовано".
# Токен: напиши @BotFather -> /newbot. chat_id: напиши @userinfobot -> он пришлёт твой ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Meta Ads — агент рекламных кампаний (meta_ads_agent.py, см. docs/META_ADS.md)
# Токен System User из Business Manager с правами ads_management, ads_read, pages_read_engagement.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_...
META_PAGE_ID=
# Instagram-аккаунт для показа рекламы в Instagram от его имени (опционально)
META_IG_USER_ID=
# Пиксель — только для кампаний с optimization_goal=OFFSITE_CONVERSIONS
META_PIXEL_ID=
# false (по умолчанию) — dry-run: ничего не меняет в рекламе, только пишет в лог
META_ADS_LIVE=false
# Общий дневной бюджет на все 4 кампании (перекрывает campaigns.json)
META_ADS_TOTAL_DAILY_BUDGET=
# Claude для текстов объявлений
ANTHROPIC_API_KEY=
